# Ghostty configuration migrated from the previous Kitty cyberpunk setup.

# Font and terminal grid
font-family = JetBrains Mono
font-family-bold = JetBrains Mono
font-family-italic = JetBrains Mono
font-family-bold-italic = JetBrains Mono
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 10
adjust-cell-height = 10%
window-width = 120
window-height = 28

# Cyberpunk colors
background = #0d0d1a
foreground = #a0a0a0
selection-background = #3d3d5c
selection-foreground = #ffffff
cursor-color = #00ffff
cursor-text = #0d0d1a
cursor-style = block
cursor-style-blink = true
palette = 0=#0a0a0a
palette = 1=#ff0055
palette = 2=#00ff88
palette = 3=#ffaa00
palette = 4=#00bfff
palette = 5=#ff00ff
palette = 6=#00ffff
palette = 7=#909090
palette = 8=#555555
palette = 9=#ff6e6e
palette = 10=#50ffaa
palette = 11=#ffcc00
palette = 12=#87cefa
palette = 13=#ff79c6
palette = 14=#8be9fd
palette = 15=#c0c0c0

# Window and split appearance
window-decoration = none
window-padding-x = 12
window-padding-y = 12
window-padding-balance = false
background-opacity = 0.87
background-blur = 40
unfocused-split-opacity = 0.7
unfocused-split-fill = #0d0d1a
split-divider-color = #ff00ff
window-show-tab-bar = always
gtk-tabs-location = bottom
gtk-wide-tabs = false

# Terminal behavior
scrollback-limit = 10000000
confirm-close-surface = false
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
link-url = true
bell-features = no-system,no-audio,attention,title,border

# zsh integration, including sudo and remote terminfo compatibility
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo,path

# Clipboard and font sizing
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Splits
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+alt+arrow_left=resize_split:left,5
keybind = ctrl+shift+alt+arrow_right=resize_split:right,5
keybind = ctrl+shift+alt+arrow_up=resize_split:up,5
keybind = ctrl+shift+alt+arrow_down=resize_split:down,5
keybind = ctrl+shift+z=toggle_split_zoom

# Tabs
keybind = ctrl+shift+t=new_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5

# Scrollback
keybind = ctrl+shift+arrow_up=scroll_page_lines:-1
keybind = ctrl+shift+arrow_down=scroll_page_lines:1
keybind = ctrl+shift+page_up=scroll_page_up
keybind = ctrl+shift+page_down=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom
