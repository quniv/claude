[astra-monitor]
experimental-features='[]'
gpu-header-activity-graph=true
gpu-header-memory-graph=true
gpu-header-memory-percentage=true
gpu-header-show=false
gpu-indicators-order='["icon","activity bar","activity graph","activity percentage","memory bar","memory graph","memory percentage","memory value"]'
headers-height=0
headers-height-override=0
memory-header-value=true
memory-indicators-order='["icon","bar","graph","percentage","value","free"]'
monitors-order='["processor","gpu","memory","storage","network","sensors"]'
network-header-io=true
network-indicators-order='["icon","IO bar","IO graph","IO speed"]'
panel-box='left'
panel-margin-left=0
processor-header-graph=false
processor-header-graph-breakdown=false
processor-header-icon=true
processor-header-percentage=true
processor-header-percentage-core=false
processor-indicators-order='["icon","bar","graph","percentage","frequency"]'
processor-menu-gpu-color=''
sensors-header-sensor1='{"service":"hwmon","path":["acpitz","temp1","input"]}'
sensors-header-sensor1-show=true
sensors-header-show=true
sensors-indicators-order='["icon","value"]'
storage-header-value=true
storage-indicators-order='["icon","bar","percentage","value","free","IO bar","IO graph","IO speed"]'

[caffeine]
cli-toggle=false

[clipboard-indicator]
blink-icon-on-copy=true
cache-size=21
disable-down-arrow=true
display-mode=1
history-size=100
move-item-first=true
open-at-cursor=true
toggle-menu=['<Alt>v']
topbar-preview-size=18

[dash-to-dock]
always-center-icons=true
apply-custom-theme=true
background-opacity=0.80000000000000004
click-action='focus-or-previews'
custom-theme-shrink=false
dance-urgent-applications=true
dash-max-icon-size=24
disable-overview-on-startup=true
dock-fixed=false
dock-position='BOTTOM'
extend-height=false
height-fraction=0.5
hide-tooltip=true
hot-keys=true
icon-size-fixed=true
intellihide=false
intellihide-mode='ALL_WINDOWS'
isolate-monitors=true
isolate-workspaces=true
multi-monitor=false
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
preview-size-scale=1.0
scroll-to-focused-application=true
show-apps-at-top=true
show-dock-urgent-notify=false
show-favorites=false
show-icons-emblems=false
show-mounts=true
show-running=true
show-show-apps-button=false
show-trash=false
workspace-agnostic-urgent-windows=true

[display-brightness-ddcutil]
ddcutil-binary-path='/usr/bin/ddcutil'
ddcutil-queue-ms=130.0
ddcutil-sleep-multiplier=40.0
decrease-brightness-shortcut=['']
increase-brightness-shortcut=['']
only-all-slider=true
position-system-menu=3.0
show-all-slider=true
show-internal-slider=true
show-value-label=true
step-change-keyboard=2.0

[notification-timeout]
always-normal=false

[space-bar/appearance]
application-styles='.space-bar {\n  -natural-hpadding: 12px;\n}\n\n.space-bar-workspace-label.active {\n  margin: 0 4px;\n  background-color: rgba(255,255,255,0.3);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,1);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}\n\n.space-bar-workspace-label.inactive.empty {\n  margin: 0 4px;\n  background-color: rgba(0,0,0,0);\n  color: rgba(255,255,255,0.5);\n  border-color: rgba(0,0,0,0);\n  font-weight: 700;\n  border-radius: 4px;\n  border-width: 0px;\n  padding: 3px 8px;\n}'

[space-bar/behavior]
always-show-numbers=true
enable-custom-label=false
indicator-style='current-workspace'
reevaluate-smart-workspace-names=false
show-empty-workspaces=false
smart-workspace-names=false
toggle-overview=true

[space-bar/state]
version=34
